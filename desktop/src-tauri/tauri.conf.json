{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NovelShelf",
  "version": "1.0.0",
  "identifier": "jp.novelshelf.desktop",
  "build": {
    "frontendDist": "../../frontend/out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NovelShelf",
        "width": 1200,
        "height": 860,
        "minWidth": 380,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
