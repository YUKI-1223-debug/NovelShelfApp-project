.env
.DS_Store
*.pem
*.key

# Firebase サービスアカウント等の秘密ファイル（ミニPCデプロイ時にホストへ置く）
/secrets/
google-services.json
# iOS の Firebase クライアント設定。Codemagic では GOOGLE_SERVICE_INFO_PLIST_B64（secure 環境変数）を
# ビルド時にデコードして配置する（codemagic.yaml 参照）。原本は WorkSpace/NovelShelf-secrets/。
GoogleService-Info.plist

# App Store Connect API キー
*.p8
AuthKey_*

# iOS 署名ファイル（秘密鍵を含む。NovelShelf-secrets/ に保管）
*.p12
*.mobileprovision

# ローカル作業メモ・スクリーンショット（リポジトリに入れない）
/URL.txt
/ScreenShot/
/新規 テキスト ドキュメント.txt
